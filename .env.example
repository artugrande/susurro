# App wallet that signs Arkiv writes and pays GLM gas (BRAGA testnet).
# Get testnet GLM at https://braga.hoodi.arkiv.network/faucet/
ARKIV_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Public address of the app wallet above (used as trusted $creator filter).
NEXT_PUBLIC_ARKIV_APP_ADDRESS=0xYOUR_ADDRESS

# ElevenLabs Conversational AI agent id (public agent).
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_xxx

# Privy app id (public, client-side). Enables email login + auto-created
# embedded wallets so users onboard without a browser extension or seed phrase.
# Get it at https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
